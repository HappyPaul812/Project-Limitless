  m_Script: {fileID: 11500000, guid: c5c82de195ab08742b4c2ed83c2494f1, type: 3}
  m_Name: Main24_FirstSnowWarning
  m_EditorClassIdentifier: Assembly-CSharp::ProjectLimitless.Core.QuestDefinition
  questId: main_24_first_snow_warning
  displayName: 첫눈 아래의 경고
  description: 비결제 첫 플레이 격리 후보. F2 안전 왕복까지 구현되었으며 첫 한기 전투와 Main24 완료는 미구현입니다.
  questType: 0
  objectives:
  - objectiveId: hear_skill_guidance
    description: 마을 남동쪽 스킬상점에서 무료 기본3과 장착6칸 안내를 끝까지 들으세요. 구매는 필요 없습니다.
    objectiveType: 0
    targetId: frostway-skill-shop
    requiredCount: 1
  - objectiveId: hear_chill_preparation
    description: 마을 남서쪽 보급 안내에서 한기의 위험과 해제 수단 준비를 확인하세요.
    objectiveType: 0
    targetId: frostway-supply
    requiredCount: 1
  - objectiveId: approach_north_gate
    description: 중앙 길을 따라 북문으로 이동하세요. 첫눈의 숲은 마을 북쪽입니다.
    objectiveType: 1
    targetId: frostway_main24_north_gate
    requiredCount: 1
  - objectiveId: main24_candidate_enter_f2
    description: 북문에서 첫눈의 숲으로 들어가세요. 스킬 구매는 필요 없습니다.
    objectiveType: 1
    targetId: main24_candidate_f2_entry
    requiredCount: 1
  - objectiveId: main24_candidate_observe_f2
    description: 가운데 흙길을 따라 북동쪽 첫눈 관찰 표식을 조사하세요. 전투는 없습니다.
    objectiveType: 3
    targetId: main24_candidate_f2_observe
    requiredCount: 1
  - objectiveId: main24_candidate_return_village
    description: 남쪽 출구로 돌아가 서릿길 마을 북문에 복귀하세요.
    objectiveType: 1
    targetId: main24_candidate_f2_return
    requiredCount: 1
  - objectiveId: await_f2_opening
    description: F2 안전 왕복 확인. 첫 한기 전투와 Main24 후속 이야기는 준비 중입니다. 완료·보상은 없습니다.
    objectiveType: 4
    targetId: frostway_main24_f2_ready
    requiredCount: 1
  reward:
    Experience: 0
    Currency: 0
    Items: []
