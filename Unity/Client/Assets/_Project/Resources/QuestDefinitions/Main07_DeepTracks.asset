  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5c82de195ab08742b4c2ed83c2494f1, type: 3}
  m_Name: Main07_DeepTracks
  m_EditorClassIdentifier: Assembly-CSharp::ProjectLimitless.Core.QuestDefinition
  questId: main_07_deep_tracks
  displayName: "\uAE4A\uAC8C \uD328\uC778 \uD754\uC801"
  description: "숲길의 깊은 두 줄 바퀴 자국을 따라가 부상자를 돕고, 진흙에 빠진 마도사 폴과 만나 함께 몬스터를 물리친다."
  questType: 0
  objectives:
  - {objectiveId: inspect_wheel_tracks, description: "숲길에 남은 두 줄의 깊은 흔적을 조사하세요.", objectiveType: 3, targetId: field02_main07_wheel_tracks, requiredCount: 1}
  - {objectiveId: help_wounded_traveler, description: "숲길의 부상자에게 다가가세요.", objectiveType: 3, targetId: field02_main07_wounded_traveler, requiredCount: 1}
  - {objectiveId: follow_wheel_tracks, description: "숲길에 남은 두 줄의 깊은 흔적을 따라가세요.", objectiveType: 1, targetId: field02_main07_paul_trail, requiredCount: 1}
  - {objectiveId: talk_to_paul, description: "진흙에 빠진 폴과 대화하세요.", objectiveType: 0, targetId: companion_paul, requiredCount: 1}
  - {objectiveId: win_paul_encounter, description: "주변 몬스터 무리를 물리치세요.", objectiveType: 2, targetId: field02_main07_paul_encounter, requiredCount: 1}
  - {objectiveId: return_to_miel, description: "미엘에게 돌아가세요.", objectiveType: 1, targetId: field02_main07_return_to_miel, requiredCount: 1}
  - {objectiveId: miel_meets_paul, description: "미엘과 폴의 상태를 확인하세요.", objectiveType: 3, targetId: field02_main07_miel_meeting, requiredCount: 1}
  - {objectiveId: say_farewell_to_paul, description: "떠나기 전 폴과 대화하세요.", objectiveType: 3, targetId: field02_main07_paul_farewell, requiredCount: 1}
  reward: {Experience: 30, Currency: 25, Items: []}
