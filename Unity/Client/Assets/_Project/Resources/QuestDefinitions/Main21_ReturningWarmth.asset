  m_Script: {fileID: 11500000, guid: c5c82de195ab08742b4c2ed83c2494f1, type: 3}
  m_Name: Main21_ReturningWarmth
  m_EditorClassIdentifier: Assembly-CSharp::ProjectLimitless.Core.QuestDefinition
  questId: main_21_returning_warmth
  displayName: "돌아온 온기"
  description: "서부의 복구를 마무리하고 접근 가능한 마차로 초보 마을에 돌아온다."
  questType: 0
  objectives:
  - objectiveId: inspect_receding_heat
    description: "달라진 지면의 열기를 확인하세요."
    objectiveType: 3
    targetId: field10_main21_heat_change
    requiredCount: 1
  - objectiveId: inspect_remaining_pulse
    description: "세린과 남아 있는 진동을 조사하세요."
    objectiveType: 3
    targetId: field10_main21_pulse_trace
    requiredCount: 1
  - objectiveId: defeat_residual_group_a
    description: "균열 주변의 몬스터를 물리치세요."
    objectiveType: 2
    targetId: field10_main21_encounter_a
    requiredCount: 1
  - objectiveId: inspect_passage_options
    description: "폴과 통행로 후보를 조사하세요."
    objectiveType: 3
    targetId: field10_main21_passage_briefing
    requiredCount: 1
  - objectiveId: select_safe_passage
    description: "단서를 비교해 안전한 통행로를 선택하세요."
    objectiveType: 3
    targetId: field10_main21_passage_decision
    requiredCount: 1
  - objectiveId: defeat_residual_group_b
    description: "통행로에 남은 몬스터를 물리치세요."
    objectiveType: 2
    targetId: field10_main21_encounter_b
    requiredCount: 1
  - objectiveId: verify_passage_safety
    description: "태온과 통행로의 안전을 최종 확인하세요."
    objectiveType: 3
    targetId: field10_main21_passage_verified
    requiredCount: 1
  - objectiveId: report_to_leon
    description: "아르벨의 레온에게 결과를 보고하세요."
    objectiveType: 3
    targetId: arbel_main21_report_leon
    requiredCount: 1
  - objectiveId: assist_residents
    description: "미엘과 함께 주민 지원을 마무리하세요."
    objectiveType: 3
    targetId: arbel_main21_aid_point
    requiredCount: 1
  - objectiveId: return_by_carriage
    description: "귀환 마차를 타고 초보 마을로 돌아가세요."
    objectiveType: 1
    targetId: starter_village_main21_carriage_arrival
    requiredCount: 1
  - objectiveId: inspect_northern_frost
    description: "마을 북쪽의 이상 징후를 조사하세요."
    objectiveType: 3
    targetId: starter_village_main21_north_trace
    requiredCount: 1
  - objectiveId: meet_haren
    description: "태온의 형 하렌을 만나세요."
    objectiveType: 3
    targetId: starter_village_main21_haren_meeting
    requiredCount: 1
  - objectiveId: prepare_northbound
    description: "북쪽 탐험 준비를 정리하세요."
    objectiveType: 3
    targetId: starter_village_main21_departure_briefing
    requiredCount: 1
  reward:
    Experience: 100
    Currency: 60
    Items: []
