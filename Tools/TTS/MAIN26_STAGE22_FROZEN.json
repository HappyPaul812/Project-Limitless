  "rows": [
    {
      "order": 1,
      "candidate_id": "main26_miel_001",
      "proposed_stage_id": "ch3stage_main26_miel_001",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "먼저 상태를 확인할게요. 서둘러 움직이지 마세요.",
      "stage": "쉼터",
      "runtime_id": null
    },
    {
      "order": 2,
      "candidate_id": "main26_serin_001",
      "proposed_stage_id": "ch3stage_main26_serin_001",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "눈바람이 한곳에 모이고 있어요.",
      "stage": "쉼터",
      "runtime_id": null
    },
    {
      "order": 3,
      "candidate_id": "main26_paul_001",
      "proposed_stage_id": "ch3stage_main26_paul_001",
      "speaker_id": "companion_paul",
      "voice": "Achird",
      "approved_text": "마력이 응축되고 있습니다. 저 공격은 한기보다 위험할 수 있어요.",
      "stage": "정령 예고",
      "runtime_id": null
    },
    {
      "order": 4,
      "candidate_id": "main26_miel_002",
      "proposed_stage_id": "ch3stage_main26_miel_002",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "동상은 행동하지 못하는 동안 체력도 줄어듭니다. 연고를 준비해 주세요.",
      "stage": "정령 예고",
      "runtime_id": null
    },
    {
      "order": 5,
      "candidate_id": "main26_haren_001",
      "proposed_stage_id": "ch3stage_main26_haren_001",
      "speaker_id": "story_haren",
      "voice": "Alnilam",
      "approved_text": "위험하니까 넌 안에 있어. 내가 확인하고 올게.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 6,
      "candidate_id": "main26_taeon_001",
      "proposed_stage_id": "ch3stage_main26_taeon_001",
      "speaker_id": "companion_taeon",
      "voice": "Algieba",
      "approved_text": "형, 나 혼자 하겠다는 게 아니야. 우리가 어디로 갈지 같이 정하자는 거야.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 7,
      "candidate_id": "main26_haren_002",
      "proposed_stage_id": "ch3stage_main26_haren_002",
      "speaker_id": "story_haren",
      "voice": "Alnilam",
      "approved_text": "네가 다치면 어쩌려고!",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 8,
      "candidate_id": "main26_taeon_002",
      "proposed_stage_id": "ch3stage_main26_taeon_002",
      "speaker_id": "companion_taeon",
      "voice": "Algieba",
      "approved_text": "나도 형이 다치는 건 싫어. 그래서 혼자 가게 두기 싫은 거야.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 9,
      "candidate_id": "main26_serin_002",
      "proposed_stage_id": "ch3stage_main26_serin_002",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "저는 바람이 덜 부는 쪽을 볼게요.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 10,
      "candidate_id": "main26_paul_002",
      "proposed_stage_id": "ch3stage_main26_paul_002",
      "speaker_id": "companion_paul",
      "voice": "Achird",
      "approved_text": "바퀴와 짐수레가 지나갈 길을 확인하겠습니다.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 11,
      "candidate_id": "main26_miel_003",
      "proposed_stage_id": "ch3stage_main26_miel_003",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "저는 주민들의 상태를 살필게요.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 12,
      "candidate_id": "main26_haren_003",
      "proposed_stage_id": "ch3stage_main26_haren_003",
      "speaker_id": "story_haren",
      "voice": "Alnilam",
      "approved_text": "…알았어. 같이 가자.",
      "stage": "갈등",
      "runtime_id": null
    },
    {
      "order": 13,
      "candidate_id": "main26_serin_003",
      "proposed_stage_id": "ch3stage_main26_serin_003",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "미엘 씨, 폴 씨가 요즘 미엘 씨 몫의 차부터 챙기던데요?",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 14,
      "candidate_id": "main26_miel_004",
      "proposed_stage_id": "ch3stage_main26_miel_004",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "어머, 그런 것까지 보고 계셨어요?",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 15,
      "candidate_id": "main26_serin_004",
      "proposed_stage_id": "ch3stage_main26_serin_004",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "하하, 제가 사수잖아요. 놓치는 게 별로 없죠.",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 16,
      "candidate_id": "main26_miel_005",
      "proposed_stage_id": "ch3stage_main26_miel_005",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "그럼 저도 조심해야겠네요.",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 17,
      "candidate_id": "main26_serin_005",
      "proposed_stage_id": "ch3stage_main26_serin_005",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "그런데 미엘 씨는 다른 분들 치료부터 하시면서, 정작 자기 손은 왜 늘 나중이에요?",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 18,
      "candidate_id": "main26_miel_006",
      "proposed_stage_id": "ch3stage_main26_miel_006",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "……예전에도 저한테 먼저 치료받으라고 하던 사람이 있었어요.",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 19,
      "candidate_id": "main26_serin_006",
      "proposed_stage_id": "ch3stage_main26_serin_006",
      "speaker_id": "companion_serin",
      "voice": "Erinome",
      "approved_text": "그럼 이번엔 제 말도 들어 주세요. 차 식기 전에 마셔요.",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 20,
      "candidate_id": "main26_miel_007",
      "proposed_stage_id": "ch3stage_main26_miel_007",
      "speaker_id": "companion_miel",
      "voice": "Sulafat",
      "approved_text": "네. 이번엔 그럴게요.",
      "stage": "쉼터 수다",
      "runtime_id": null
    },
    {
      "order": 21,
      "candidate_id": "main26_taeon_003",
      "proposed_stage_id": "ch3stage_main26_taeon_003",
      "speaker_id": "companion_taeon",
      "voice": "Algieba",
      "approved_text": "이제 더 북쪽을 확인해 보죠.",
      "stage": "마무리",
      "runtime_id": null
    },
    {
      "order": 22,
      "candidate_id": "main26_haren_004",
      "proposed_stage_id": "ch3stage_main26_haren_004",
      "speaker_id": "story_haren",
      "voice": "Alnilam",
      "approved_text": "그래.",
      "stage": "마무리",
      "runtime_id": null
    }
  ],
