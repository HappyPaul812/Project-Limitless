  "rows": [
    {
      "clip_id": "main16_start_leon_01",
      "quest_no": "16",
      "scene_key": "start",
      "speaker_id": "arbel-leon",
      "speaker": "레온",
      "text": "바람이 거의 없는데 재가 움직였다는 증언이 있습니다. 큰 불길을 보지 못했는데 땅은 뜨겁다고 하고요. 검은 연기 같은 형체를 봤다는 소문도 들립니다.",
      "voice_id": "Orus",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_start_leon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_start_leon_02",
      "quest_no": "16",
      "scene_key": "start",
      "speaker_id": "arbel-leon",
      "speaker": "레온",
      "text": "평소 같으면 잘못 본 거라고 생각했겠지만, 요즘은 그렇게 넘기기가 어렵군요.",
      "voice_id": "Orus",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_start_leon_02.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_start_paul_01",
      "quest_no": "16",
      "scene_key": "start",
      "speaker_id": "companion_paul",
      "speaker": "폴",
      "text": "확인할 수 있는 건 직접 확인하죠. 소문이 사실인지부터요.",
      "voice_id": "Achird",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_start_paul_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_ash_hearing_serin_01",
      "quest_no": "16",
      "scene_key": "ash_hearing",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "저도 그렇게 잡혀요.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_ash_hearing_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_ash_hearing_serin_02",
      "quest_no": "16",
      "scene_key": "ash_hearing",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "다만 어느 쪽이 먼저인지는 아직 모르겠습니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_ash_hearing_serin_02.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_ash_default_serin_01",
      "quest_no": "16",
      "scene_key": "ash_default",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "땅이 울릴 때마다 움직여요.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_ash_default_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_ash_default_taeon_01",
      "quest_no": "16",
      "scene_key": "ash_default",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "진동과 관련이 있다는 말씀이십니까?",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_ash_default_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_ash_default_serin_02",
      "quest_no": "16",
      "scene_key": "ash_default",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "같이 일어나는 건 맞아요. 어느 쪽이 원인인지는 모르겠습니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_ash_default_serin_02.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_vibration_hearing_serin_01",
      "quest_no": "16",
      "scene_key": "vibration_hearing",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "네. 방향은 같습니다. 다만 어디에서 시작되는지는 아직 모르겠습니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_vibration_hearing_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_vibration_default_serin_01",
      "quest_no": "16",
      "scene_key": "vibration_default",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "서쪽에서 오는 진동이 더 강해요. 간격에도 변화가 있습니다. 발생원은 아직 모르겠습니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_vibration_default_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_tracks_paul_01",
      "quest_no": "16",
      "scene_key": "tracks",
      "speaker_id": "companion_paul",
      "speaker": "폴",
      "text": "여기까지는 계속 서쪽으로 갔습니다.",
      "voice_id": "Achird",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_tracks_paul_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_tracks_miel_01",
      "quest_no": "16",
      "scene_key": "tracks",
      "speaker_id": "companion_miel",
      "speaker": "미엘",
      "text": "그런데 여기서 전부 방향을 바꿨네요.",
      "voice_id": "Sulafat",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_tracks_miel_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_tracks_taeon_01",
      "quest_no": "16",
      "scene_key": "tracks",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "무언가를 피한 것으로 보입니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_tracks_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_witness_taeon_01",
      "quest_no": "16",
      "scene_key": "witness_emerge",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "모두 준비하세요. 저 형체가 다가옵니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_witness_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_retry_taeon_01",
      "quest_no": "16",
      "scene_key": "retry",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "아직 그 형체가 남아 있습니다. 준비가 되면 다시 상대하죠.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_retry_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_afterimage_hearing_serin_01",
      "quest_no": "16",
      "scene_key": "afterimage_hearing",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "네. 저도 잡힙니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_afterimage_hearing_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_afterimage_default_serin_01",
      "quest_no": "16",
      "scene_key": "afterimage_default",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "아직 계속됩니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_afterimage_default_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_afterimage_paul_01",
      "quest_no": "16",
      "scene_key": "afterimage_common",
      "speaker_id": "companion_paul",
      "speaker": "폴",
      "text": "그러면 저게 진동을 만든 건 아니군요.",
      "voice_id": "Achird",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_afterimage_paul_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_afterimage_taeon_01",
      "quest_no": "16",
      "scene_key": "afterimage_common",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "적어도 모든 원인은 아니라는 뜻이겠습니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_afterimage_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_afterimage_taeon_02",
      "quest_no": "16",
      "scene_key": "afterimage_common",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "열기의 일부가 지하에서 올라오는 것일 수 있습니다. 아직 가설입니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_afterimage_taeon_02.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_canyon_hearing_serin_01",
      "quest_no": "16",
      "scene_key": "canyon_hearing",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "네. 그 방향과 반복이 같이 잡힙니다. 정확한 발생 위치는 아직 모릅니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_canyon_hearing_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_canyon_default_serin_01",
      "quest_no": "16",
      "scene_key": "canyon_default",
      "speaker_id": "companion_serin",
      "speaker": "세린",
      "text": "진동은 붉은 균열 협곡 방향에서 더 강해요. 정확한 발생 위치는 아직 모르겠습니다.",
      "voice_id": "Schedar",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_canyon_default_serin_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_canyon_taeon_01",
      "quest_no": "16",
      "scene_key": "canyon_common",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "오늘은 여기까지 확인하는 편이 좋겠습니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_canyon_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_canyon_paul_01",
      "quest_no": "16",
      "scene_key": "canyon_common",
      "speaker_id": "companion_paul",
      "speaker": "폴",
      "text": "찬성입니다. 확인과 무모함은 다른 일이니까요.",
      "voice_id": "Achird",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_canyon_paul_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_canyon_miel_01",
      "quest_no": "16",
      "scene_key": "canyon_common",
      "speaker_id": "companion_miel",
      "speaker": "미엘",
      "text": "아르벨에 먼저 알려야겠어요.",
      "voice_id": "Sulafat",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_canyon_miel_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_report_taeon_01",
      "quest_no": "16",
      "scene_key": "report",
      "speaker_id": "companion_taeon",
      "speaker": "태온",
      "text": "열기의 일부가 지하에서 올라올 가능성은 있습니다. 가설일 뿐이며 재와 진동의 원인, 형체의 정체는 아직 모릅니다.",
      "voice_id": "Gacrux",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_report_taeon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_report_leon_01",
      "quest_no": "16",
      "scene_key": "report",
      "speaker_id": "arbel-leon",
      "speaker": "레온",
      "text": "그러면 동물들만 변하고 있는 게 아니군요.",
      "voice_id": "Orus",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_report_leon_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    },
    {
      "clip_id": "main16_report_paul_01",
      "quest_no": "16",
      "scene_key": "report",
      "speaker_id": "companion_paul",
      "speaker": "폴",
      "text": "네. 적어도 이제는 그렇게 보는 편이 맞겠습니다.",
      "voice_id": "Achird",
      "model": "gemini-3.8-flash-tts",
      "output_file": "segments/main16_report_paul_01.wav",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/Main16DialogueCatalog.cs"
    }
  ],
