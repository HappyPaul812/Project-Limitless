      "sha256": "0ca36ce3da8945db5bf7861afb52f8367d4d0fdc071e21e9eba880fbb1ccdfd6",
      "seconds": 1.53
    },
    {
      "id": "main08_taeon_supp_002",
      "quest": 8,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "여기부터 흔적이 거의 없습니다.",
