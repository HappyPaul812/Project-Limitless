      "sha256": "7542570369d2a1a92d9611b5b81c978040c8c01ef42b0d9aa5b3c402595e8b55",
      "seconds": 1.81
    },
    {
      "id": "main05_taeon_supp_003",
      "quest": 5,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "괜찮으시다면…\n조금 더 함께 가겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest05ReturnFlow.cs",
