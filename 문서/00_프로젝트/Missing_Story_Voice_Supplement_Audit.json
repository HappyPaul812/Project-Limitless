      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "몬스터들이 여기를 피하는 이유가 있는 거겠죠?",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest08FieldFlow.cs",
      "source_line": "70",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main08/main08_miel_supp_007.wav",
      "guid": "9c62dffde6c33ed478eb95ac2c6f1a2e",
      "sha256": "4e6125b932e12ad1d94d1111818e1d31f6f32e958a9edd0c7e9d392a8ebbbd87",
      "seconds": 3.51
    },
    {
      "id": "main08_taeon_supp_010",
