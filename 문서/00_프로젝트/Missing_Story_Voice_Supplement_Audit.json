      "sha256": "c49a6affec6aa8532bdd9b2e692d498179d92af4b4d6e655fe115b082d3deb10",
      "seconds": 6.06
    },
    {
      "id": "main04_miel_supp_003",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "알아요.\n그래도 아직 움직일 수 있어요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
