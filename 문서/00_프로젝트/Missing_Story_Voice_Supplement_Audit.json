      "seconds": 1.03
    },
    {
      "id": "main08_miel_supp_001",
      "quest": 8,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "몬스터가 적다는 건 좋은 일 아닌가요?",
