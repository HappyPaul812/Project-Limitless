      "sha256": "8f542e95d5ab7ff25c85fc609a2178050557e02fd3b42c7a9cec0c02ad025b81",
      "seconds": 3.53
    },
    {
      "id": "main08_miel_supp_005",
      "quest": 8,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "폴 씨일까요?",
