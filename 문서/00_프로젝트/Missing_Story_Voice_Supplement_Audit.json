      "sha256": "7075ffb191443725ecc01680d92a4cabb258d1b7f4766808b4ad6cc3bc777e2c",
      "seconds": 2.41
    },
    {
      "id": "main08_taeon_supp_004",
      "quest": 8,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "그런데 조금 전까지 이쪽으로 이어지던 흔적들이 전부 방향을 바꾸고 있습니다.",
