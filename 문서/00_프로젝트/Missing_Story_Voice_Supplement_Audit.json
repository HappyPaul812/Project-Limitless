      "sha256": "ea895d4960cba09021d863b7349370fdb4ade354b53fc98b94a53c7f12722f07",
      "seconds": 4.9
    },
    {
      "id": "main03_taeon_supp_002",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "누군가 먼저 이곳을 지나간 것 같습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "137",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_002.wav",
