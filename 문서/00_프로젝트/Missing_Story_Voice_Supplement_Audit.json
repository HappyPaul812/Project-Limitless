      "seconds": 3.94
    },
    {
      "id": "main03_taeon_supp_003",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "옵니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "218",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_003.wav",
      "guid": "9e9daa2d47a707049a7c0c73b5921ae4",
      "sha256": "76f76e68dea34351d86ba16861c36f28b05e5ab519d49894fdd25d0675f3bf30",
      "seconds": 1.1
    },
    {
      "id": "main03_taeon_supp_004",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "제가 앞을 막겠습니다.\n뒤를 부탁드리겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "219",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_004.wav",
      "guid": "574895e9a2b5b3b45a251673fd085670",
      "sha256": "179e399821fc8c67bb87e7e42b576ed5029db7d035a4ea58bf3223a516eb142f",
      "seconds": 1.65
    },
    {
      "id": "main03_taeon_supp_005",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "잠깐만요. 더 가까이 가지 않는 게 좋겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "238",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_005.wav",
      "guid": "0dc9970aa869f5645add7545bc7696ca",
      "sha256": "1a2d517bf7981325076b54ffa214ef5e1a53e1db41338747bdcbd4272e489800",
      "seconds": 3.91
    },
    {
      "id": "main03_taeon_supp_006",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "저 몬스터들 말입니다.\n그냥 돌아다니는 것 같지만…\n계속 같은 쪽을 피하고 있어요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "240",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_006.wav",
      "guid": "86cecb5f27e225f4f9a992b37e2e17e9",
      "sha256": "74943b5bc927014355e7a328a28d6272891ad4a6bafdb7d87fa6dbb0d66b456d",
      "seconds": 4.34
    },
    {
      "id": "main03_taeon_supp_007",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "그렇군요.\n그러면 제가 보고 있던 움직임하고\n이어질지도 모르겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "242",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_007.wav",
      "guid": "50d6684884c921344a0d2630b2b07e66",
      "sha256": "18c345f845c18c97aa4857dd5fa48d76ad310654f937cfa7177df393e727a6ed",
      "seconds": 2.71
    },
    {
      "id": "main03_taeon_supp_008",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "역시 이상합니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "249",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_008.wav",
      "guid": "16a05ac1b6d319545a8f9113e2bd9aba",
      "sha256": "a16d378060acc7ff290a24bd65f28fb62548da49416eada089bae144c6d7042c",
      "seconds": 2.25
    },
    {
      "id": "main03_taeon_supp_009",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "네.\n싸우는 동안에도 몇 번이나\n그쪽으로 움직이지 않으려고 했어요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "251",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_009.wav",
      "guid": "dde64e7754b8a3c4c8a39ff54113e2a4",
      "sha256": "41230a2b6183075d81ef0c5e7270f55c226f8195b6bf106a764ae949b625e9c9",
      "seconds": 2.76
    },
    {
      "id": "main03_taeon_supp_010",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "그렇다면 우연은 아닌 것 같습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "253",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_010.wav",
      "guid": "df90274da1dfe6349a613703673baa14",
      "sha256": "edd61fc146cdbfae19b99947517b4088d0b799a4a669055594997fad4d7c5aab",
      "seconds": 1.62
    },
    {
      "id": "main03_taeon_supp_011",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "저도 저쪽을 확인하려던 참이었습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "254",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_011.wav",
      "guid": "e6098de83891e8d4a848af3eb519d63f",
      "sha256": "b066045b2d36b539126065ca4c6a0ea27048cb69d1686afdc045b34fcdad39be",
      "seconds": 15.24
    },
    {
      "id": "main03_taeon_supp_012",
      "quest": 3,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "목적이 같다면 잠시 함께 가시죠.\n혼자 움직이는 것보다는 안전할 겁니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest03FieldFlow.cs",
      "source_line": "255",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main03/main03_taeon_supp_012.wav",
      "guid": "997f362bba765564c811ef7d9d7aa0c3",
      "sha256": "5769d643495209128ea13d317db81f141d920b7b87e5f69145086bba3b4d92c5",
      "seconds": 1.45
    },
    {
      "id": "main04_miel_supp_001",
