      "source_line": "67",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main08/main08_miel_supp_002.wav",
      "guid": "3896e964af209da4196fd4c8827877cb",
      "sha256": "d06d4fc4453ebdb96a43f6847b58fe617e901fb3eb54451226bbaa4d74db34d8",
      "seconds": 3.73
    },
    {
      "id": "main08_miel_supp_003",
      "quest": 8,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "다들 이쪽을 피해서 지나가고 있어요.",
