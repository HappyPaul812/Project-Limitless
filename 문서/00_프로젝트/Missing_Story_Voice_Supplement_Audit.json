      "sha256": "105bcf5ba4b71c95309360359dfc9ffa7d2e300a9af715befcba0b9d96ecb1dd",
      "seconds": 5.98
    },
    {
      "id": "main04_taeon_supp_005",
      "quest": 4,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "본인부터 보셔야 하는 것 아닙니까?",
