      "sha256": "cbb5ee777f39c9c1e96f2b8ffba2b7125223d7f6a4fac9e16039186c21afd704",
      "seconds": 4.93
    },
    {
      "id": "main04_miel_supp_008",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "괜찮으세요?\n다친 곳부터 확인할게요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "227",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_008.wav",
