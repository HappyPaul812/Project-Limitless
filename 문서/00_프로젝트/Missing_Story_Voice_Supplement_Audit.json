      "source_line": "67",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main08/main08_miel_supp_003.wav",
      "guid": "f7bdf41280580d243adfc2e0497efd74",
      "sha256": "21d143ebd34e6ec8038d9335897494d6f4bc3fc0c30c5d54cbe3e90c28e37b23",
      "seconds": 5.12
    },
    {
      "id": "main08_taeon_supp_005",
      "quest": 8,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "초원에서는 무언가를 피해 밀려오는 것처럼 보였습니다.",
