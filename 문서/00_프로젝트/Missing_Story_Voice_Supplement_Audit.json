      "sha256": "2ecba957758ed107f3060d79a998023e6f63fd398e13da326fd642bdeeb5583f",
      "seconds": 3.04
    },
    {
      "id": "main05_taeon_supp_002",
      "quest": 5,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "저도 이 움직임이\n어디서 시작됐는지 확인하고 싶습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest05ReturnFlow.cs",
      "source_line": "92",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main05/main05_taeon_supp_002.wav",
