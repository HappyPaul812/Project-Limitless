      "sha256": "52c44f9a72449e580358e4397dbd21294ebcc28ad995e8f545818ec10d6f6307",
      "seconds": 2.56
    },
    {
      "id": "main04_taeon_supp_002",
      "quest": 4,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "당신도 다친 것 같은데요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "208",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_taeon_supp_002.wav",
