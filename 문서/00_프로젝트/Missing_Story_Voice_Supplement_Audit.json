      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_003.wav",
      "guid": "396d1adfa28d2c045919d3a43cd56438",
      "sha256": "31d777b0c37a1438dd013fe627e0ef005b23d5a39a0b0e34ac82dc3dcefcfe1a",
      "seconds": 3.11
    },
    {
      "id": "main04_miel_supp_004",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "몬스터들에게 습격받았습니다.\n그런데 조금 이상했어요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "211",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_004.wav",
      "guid": "e2426b334db36754a9d9b3d6ead414cc",
      "sha256": "1984ffeb6bda6a680e84d7aa7844fbfc7b894d347430e79024dbcae5efcc86bd",
      "seconds": 4.7
    },
    {
      "id": "main04_miel_supp_005",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "처음부터 사람을 노리고\n온 것 같지는 않았습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "212",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_005.wav",
      "guid": "3c3dba5e74d6ec241b4958fc79a34310",
      "sha256": "dd3b9d1180671bd3a4848f09c83fad85c27b35096ee585c8cdd6d02cc4584733",
      "seconds": 2.88
    },
    {
      "id": "main04_taeon_supp_003",
      "quest": 4,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "무언가를 피하고 있었습니까?",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "213",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_taeon_supp_003.wav",
      "guid": "d1cef965a60b4994a9efc9355fb3e79b",
      "sha256": "d558546ac0dec7aa4acac3d99f6300d9b82c76106c19662601d125d6ef2686d1",
      "seconds": 3.76
    },
    {
      "id": "main04_miel_supp_006",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "네.\n갑자기 길을 가로막게 되자\n공격한 것처럼 보였어요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "214",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_006.wav",
      "guid": "96e329a599d28f746b02246d49b2683f",
      "sha256": "4a583011800ae4ab50d8a41fa19183cafe62a129e7a785defde5d3fb6f245f27",
      "seconds": 3.11
    },
    {
      "id": "main04_taeon_supp_004",
      "quest": 4,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "또 옵니다.\n제가 앞을 맡겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "219",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_taeon_supp_004.wav",
      "guid": "62b5719981958b14683804f53f69086f",
      "sha256": "af585d0963351ea3d6d2dff7b663f6cbb0e784acbbf7de11088db7573fd0a3f1",
      "seconds": 5.27
    },
    {
      "id": "main04_miel_supp_007",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "다친 곳은 제가 보겠습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "220",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_007.wav",
