      "seconds": 3.13
    },
    {
      "id": "main04_miel_supp_002",
      "quest": 4,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "저보다 이분이 먼저예요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
