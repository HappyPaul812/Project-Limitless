      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main05/main05_miel_supp_002.wav",
      "guid": "26ff1e3155ece364ab5eef1fcf1d522a",
      "sha256": "bd67fe2e2f5b986c58cf8f40cd496e077da1167332ec79e6b307cc2da8adc1c3",
      "seconds": 3.54
    },
    {
      "id": "main05_miel_supp_003",
      "quest": 5,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "저도 같이 가겠습니다.\n제가 할 수 있는 일이 있을 거예요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest05ReturnFlow.cs",
      "source_line": "95",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main05/main05_miel_supp_003.wav",
      "guid": "f044a709c1d02394bbaa849ef7eec8fe",
      "sha256": "ef92ab806ebc0fd5ba5c8a63abb00049a8372f4bba0776fee02f55bc308cc141",
      "seconds": 4.06
    },
    {
      "id": "main08_taeon_supp_001",
      "quest": 8,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "잠깐만요.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest08FieldFlow.cs",
