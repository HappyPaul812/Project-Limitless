      "guid": "214a4ae0abdd7944095eb85ed5e23b1b",
      "sha256": "dd9441de43f1128341209aa60aa83308f04c7df801a53aef6ea1751e83fa206d",
      "seconds": 2.22
    },
    {
      "id": "main05_miel_supp_002",
      "quest": 5,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "이대로 두면\n다치는 사람이 더 생길 겁니다.",
