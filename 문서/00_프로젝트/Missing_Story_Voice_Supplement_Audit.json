      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "조금만 참으세요.\n출혈은 멎었습니다.",
      "source_file": "Unity/Client/Assets/_Project/Scripts/World/MainQuest04FieldFlow.cs",
      "source_line": "205",
      "asset": "Unity/Client/Assets/_Project/Audio/Voice/Story/Main04/main04_miel_supp_001.wav",
