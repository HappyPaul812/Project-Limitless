      "sha256": "4162175dbbc3570ed5ad1531818a9bb2939263216ec6895241bcb9885f79dbce",
      "seconds": 3.13
    },
    {
      "id": "main08_miel_supp_002",
      "quest": 8,
      "speaker": "미엘",
      "character_id": "companion_miel",
      "voice_id": "Sulafat",
      "text": "없어진 게 아니네요.",
