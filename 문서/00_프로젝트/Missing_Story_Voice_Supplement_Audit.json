      "sha256": "2b2c26ee327a47363f76c0bf86a435c8e8b3ebbb024ab959536a07ebf92ac3e2",
      "seconds": 4.5
    },
    {
      "id": "main08_taeon_supp_003",
      "quest": 8,
      "speaker": "태온",
      "character_id": "companion_taeon",
      "voice_id": "Gacrux",
      "text": "평소라면 그렇겠죠.",
